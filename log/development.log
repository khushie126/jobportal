      <p><%= @pi.experience.end_date %></p>
    </div>

    <div class="field">
      <strong>Company:</strong>
      <p><%= @pi.experience.company_name %></p>
    </div>

<div class="field">
      <strong>Description</strong>
      <p><%= @pi.experience.description%></p>
    </div>

  <% else %>
    <p>No Experience information available.</p>
  <% end %>
<%end%>
</fieldset>

