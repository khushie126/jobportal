<h1 class="page-title">Job Posts</h1>

<div class="new-job-post-btn text-center mt-4">
  <%= link_to 'New Job Post', new_job_post_path, class: 'btn btn-success' %>
</div>

<br><br>

<div class="row">
  <% @jp.each do |job_post| %>
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= job_post.title %></h5>
          <h6 class="card-subtitle mb-2 text-muted"><%= job_post.job_type %></h6>
          <p class="card-text">
            <%= truncate(job_post.description, length: 100) %>
          </p> <!-- Truncate the description to 100 characters -->
          <p class="card-text">
            <strong>Company:</strong> <%= job_post.company.company_name %>
          </p>
        <% if @job_skills[job_post.id].present? %>
          <p><strong>Required Skills:</strong></p>
          <ul>
            <% @job_skills[job_post.id].each do |skill_name| %>
              <li><%= skill_name %></li>
            <% end %>
            <%end%>
          </ul>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <div>
            <%= link_to 'Show', job_post_path(job_post), class: 'btn btn-info btn-sm' %>
            <% if current_user.admin? || current_user.recruiter? %>
              <%= link_to 'Edit', edit_job_post_path(job_post), class: 'btn btn-warning btn-sm' %>
            <% end %>
          </div>

          <div>
            <% if @applied_status[job_post.id] %>
              <p class="text-success">You have already applied for this job.</p>
            <% else %>
              <%= link_to 'Apply for Job', job_post_apply_path(job_post), method: :post, class: 'btn btn-primary btn-sm' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
