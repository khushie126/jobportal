<h1 class="page-title text-center mb-5">Job Posts</h1>
<div class="text-center mb-4">
  <%= link_to 'Back', root_path, class: 'btn btn-secondary'%>
</div>
<% if current_user.admin? || current_user.recruiter? %>
<div class="new-job-post-btn text-center mt-4">
  <%= link_to 'Create JobPost', new_job_post_path, class: 'btn btn-success' %>
</div>
<% end %>

<br><br>

<div class="row">
  <% @jp.each do |job_post| %>
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= job_post.title %></h5>
          <h6 class="card-subtitle mb-2 text-muted"><%= job_post.job_type %></h6>
          <p class="card-text">
            <%= truncate(job_post.description, length: 100) %>
          </p> <!-- Truncate the description to 100 characters -->
          <p class="card-text">
            <strong>Company:</strong> <%= job_post.company.company_name %>
          </p>
          <% if job_post.creator.present? %>
  <% if job_post.creator.role == "recruiter" %>
    <p><strong>Posted by Recruiter:</strong> <%= job_post.creator.email%></p>
  <% elsif job_post.creator.role == "admin" %>
    <p><strong>Posted by Admin:</strong> <%= job_post.creator.email %></p>
  <% end %>
<% end %>

        <% if @job_skills[job_post.id].present? %>
          <p><strong>Required Skills:</strong></p>
          <ul>
            <% @job_skills[job_post.id].each do |skill_name| %>
              <li><%= skill_name %></li>
            <% end %>
            <%end%>
          </ul>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <div>
            <%= link_to 'Show', job_post_path(job_post), class: 'btn btn-info btn-sm' %>
            <% if current_user.admin? || current_user.recruiter? %>
              <%= link_to 'Edit', edit_job_post_path(job_post), class: 'btn btn-warning btn-sm' %>
            <% end %>
          </div>
     
          <div>
             <% if job_post.creator == current_user && (current_user.recruiter? || current_user.admin?) %>
    <p class="text-danger">You cannot apply for your own job posting.</p>
            <% elsif @applied_status[job_post.id] %>
              <p class="text-success">You have already applied for this job.</p>
            <% else %>
              <%= link_to 'Apply for Job', apply_job_post_path(job_post), method: :post, class: 'btn btn-primary btn-sm' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
