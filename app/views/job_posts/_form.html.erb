<%= link_to job_posts_path, class: 'btn btn-link ' do %>
  <i class="bi bi-arrow-left me-2"></i> Back to jobposts
<% end %>

<%= form_with model: @jp, class: "job-post-form d-flex flex-column align-items-center" do |form| %>
  <div class="form-container w-75">


    <!-- Title Field -->
    <div class="form-group mb-3 w-100">
      <%= form.label :title, class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control' %>
    </div>

    <!-- Type Field -->
    <div class="form-group mb-3 w-100">
      <%= form.label :job_type, class: 'form-label' %>
      <%= form.text_field :job_type, class: 'form-control' %>
    </div>

    <!-- Description Field -->
    <div class="form-group mb-3 w-100">
      <%= form.label :description, class: 'form-label' %>
      <%= form.text_area :description, class: 'form-control' %>
    </div>

    <!-- Company Name (Dropdown) -->
    <div class="form-group mb-3 w-100">
      <%= form.label :company_id, "Company Name", class: 'form-label' %>
      <%= form.select :company_id, options_for_select(Company.all.map { |c| [c.company_name, c.id] }), {}, class: 'form-select' %>
    </div>

    <!-- Skills Section -->
 <p>Required Skills</p>
  <div id="skills">
    <%= form.fields_for :skill_assignments do |sa_form| %>
      <%= render :partial => "skill_fields", :locals => {:f => sa_form} %>
    <% end %>
    <div class="links">
      <%= link_to_add_association "Add Skills", form, :skill_assignments, partial: 'skill_fields', class: 'btn btn-link' %>
    </div>
  </div>

    <!-- Submit Button -->
    <div class="form-group mt-4">
      <%= form.submit (@jp.new_record? ? "Create JobPost" : "Update Jobpost"), class: 'btn btn-primary' %>
    </div>

  </div>
<% end %>



