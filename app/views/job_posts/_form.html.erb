<%= form_with model: @jp, class: "job-post-form" do |form| %>
  <div class="form-container">
    <% if @jp.errors.any? %>
      <div class="errors">
        <h2>There were errors with your submission:</h2>
        <ul>
          <% @jp.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Title Field -->
    <div class="form-field">
      <%= form.label :title, class: 'form-label' %>
      <%= form.text_field :title, class: 'form-input' %>
    </div>

    <!-- Type Field -->
    <div class="form-field">
      <%= form.label :job_type, class: 'form-label' %>
      <%= form.text_field :job_type, class: 'form-input' %>
    </div>

    <!-- Description Field -->
    <div class="form-field">
      <%= form.label :description, class: 'form-label' %>
      <%= form.text_area :description, class: 'form-input' %>
    </div>

    <!-- Company Name (Dropdown) -->
    <div class="form-field">
      <%= form.label :company_id, "Company Name", class: 'form-label' %>
      <%= form.select :company_id, options_for_select(Company.all.map { |c| [c.company_name, c.id] }), {}, class: 'form-select' %>
    </div>
      <div>
        
   <legend>Skills</legend>
  <div id="skills">
  <%= form.fields_for :skill_assignments do |sa_form| %>
       <%= render :partial => "skill_fields", :locals => {:f => sa_form}%>
  <% end %>
    <div class="links">
      <%= link_to_add_association "Add Skills" , form, :skill_assignments, partial: 'skill_fields' %>
    </div>
  </div>
    <!-- Submit Button -->
    <div class="form-actions">
      <%= form.submit "Create Job Post", class: 'submit-btn' %>
    </div>
  </div>
<% end %>

<!-- Back Link -->
<div class="back-link-container">
  <%= link_to "Back", job_posts_path, class: "back-link" %>
</div>

