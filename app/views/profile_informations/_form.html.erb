<%= link_to 'Back to Profiles', profile_informations_path %>
<br><br>

<%= form_with model: @pi do |form| %>
  <% if @pi.errors.any? %>
    <div class="errors">
      <h2>There were errors with your submission:</h2>
      <ul>
        <% @pi.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :firstname %>
    <%= form.text_field :firstname %>
  </div>

  <div class="field">
    <%= form.label :lastname %>
    <%= form.text_field :lastname %>
  </div>

  <div class="field">
    <%= form.label :phone_number %>
    <%= form.text_field :phone_number %>
  </div>

  <div class="field">
    <%= form.label :profile_image %>
    <%= form.file_field :profile_image , accept: "image/*" %> 
  </div>

  <div class="field">
    <%= form.label :company_id, "Company Name" %>
    <%= form.select :company_id, options_for_select(Company.all.map { |c| [c.company_name, c.id] }) %>
  </div>

  <legend>Education</legend>
  <div id="educations">
    <%= form.fields_for :educations do |education| %>
      <%= render :partial => "education_fields", :locals => { :f => education } %>
    <% end %>
    <div class="links">
      <%= link_to_add_association 'Add Education', form, :educations, partial: 'education_fields' %>
    </div>
  </div>

  <legend>Experience</legend>
  <div id="experiences">
    <%= form.fields_for :experiences do |experience| %>
      <%= render :partial => "experience_fields", :locals => { :f => experience } %>
    <% end %>
    <div class="links">
      <%= link_to_add_association 'Add Experience', form, :experiences, partial: 'experience_fields' %>
    </div>
  </div>

  <legend>Project</legend>
  <div id="projects">
    <%= form.fields_for :projects do |project| %>
      <%= render :partial => "project_fields", :locals => { :f => project} %>
    <% end %>
    <div class="links">
      <%= link_to_add_association 'Add Project', form, :projects, partial: 'project_fields' %>
    </div>
  </div>


  <legend>Skills</legend>
  <div id="skills">
  <%= form.fields_for :skill_assignments do |sa_form| %>
       <%= render :partial => "skill_fields", :locals => {:f => sa_form}%>
  <% end %>
    <div class="links">
      <%= link_to_add_association "Add Skills" , form, :skill_assignments, partial: 'skill_fields' %>
    </div>
  </div>


<div class="actions">
    <%= form.submit form_button(@pi.new_record? ? :new : :edit), class: 'submit-btn' %>
  </div>
<% end %>
