
<%= form_with model: @pi do |form| %>
  <% if @pi.errors.any? %>
    <div class="errors">
      <h2>There were errors with your submission:</h2>
      <ul>
        <% @pi.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :firstname %>
    <%= form.text_field :firstname %>
  </div>

  <div class="field">
    <%= form.label :lastname %>
    <%= form.text_field :lastname %>
  </div>

  <div class="field">
    <%= form.label :phone_number %>
    <%= form.text_field :phone_number %>
  </div>

  <div class="field">
    <%= form.label :profile_image %>
    <%= form.file_field :profile_image , accept: "image/*" %> 
  </div>

  <div class="field">
    <%= form.label :company_id, "Company Name" %>
    <%= form.select :company_id, options_for_select(Company.all.map {|c| [c.company_name, c.id]}) %>
  </div>


 <legend>Education</legend>
  <div id="educations">
    <%= form.fields_for :educations do |education| %>
      <%= render :partial => "education_fields", :locals => { :f => education } %>
    <% end %>
      <div class="links">
        <%= link_to_add_association 'Add edcuations', form, :educations, partial: 'education_fields' %>
      </div>
   </div>
</div>
  
  <legend>Experience</legend>
  <div id="experiences">
    <%= form.fields_for :experiences do |experience| %>
      <%= render :partial => "experience_fields", :locals => { :f => experience } %>
    <% end %>
      <div class="links">
        <%= link_to_add_association 'Add experiences', form, :experiences, partial: 'experience_fields' %>
      </div>
   </div>
</div>

<legend>Project</legend>
  <div id="projects">
    <%= form.fields_for :projects do |project| %>
      <%= render :partial => "project_fields", :locals => { :f => project} %>
    <% end %>
      <div class="links">
        <%= link_to_add_association 'Add projects', form, :projects, partial: 'project_fields' %>
      </div>
   </div>
</div>
<legend>Skills</legend>
 <div class="form-field">
    <%= form.label :skills %><br>
    <%= form.collection_check_boxes :skill_ids, @skills, :id, :name do |b| %>
      <div>
        <%= b.check_box %>
        <%= b.label %>
      </div>
    <% end %>
  </div>

  <div class="actions">
    <%= form.submit "Create Profile" %>
  </div>
<% end %>

<%= link_to 'Back to Profiles', profile_informations_path %>
