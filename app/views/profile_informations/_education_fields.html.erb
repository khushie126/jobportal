<div class="nested-fields">
  <div class="field">
    <%= f.label :start_date %>
    <%= f.date_select :start_date %>
  </div>

  <div class="field">
    <%= f.label :end_date %>
    <%= f.date_select :end_date %>
  </div>

  <div class="field">
    <%= f.label :college_name %>
    <%= f.text_field :college_name %>
  </div>

  <div class="field">
    <%= f.label :school_name %>
    <%= f.text_field :school_name %>
  </div>

   <div class="field">
    <%= f.label :score_type,"score_type" %>
    <%= f.select :score_type, options_for_select(Education.score_types.map {|key, value| [key.titleize, Education.score_types.key(value)]}, f.object.score_type)%>
  </div>
 
  <div class="field">
      <%= f.label :score %>
      <%= f.text_field :score %>
    </div>

  <div class="field">
 
    <%= link_to_remove_association "remove education", f %>
  </div>
</div>
 