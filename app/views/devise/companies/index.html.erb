<h1 class="mb-4">Companies</h1>
<div class="text-center mb-4">
  <%= link_to 'Back', root_path, class: 'btn btn-secondary'%>
</div>
<% if current_user.admin? || current_user.recruiter? %>
  <div class="text-center mb-5">
    <%= link_to 'Create Company Profile', new_company_path, class: 'btn btn-success btn-lg' %>
  </div>
<% end %>

<div class="row">
  <% @company.each do |company| %>
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <h5 class="card-title"><%= company.company_name %></h5>
            <h6 class="card-subtitle mb-2 text-muted">Location: <%= company.location %></h6>
            <p class="card-text"><strong>Description:</strong> <%= truncate(company.description, length: 150) %></p>
            <p class="card-text"><strong>Review:</strong> <%= company.review %></p>
          </div>
          
          <div class="d-flex justify-content align-items-center">
            <div>
            <%= link_to 'Show', company_path(company), class: 'btn btn-info btn-sm' %>
            <% if current_user.admin? || current_user.recruiter? %>
              <%= link_to 'Edit', edit_company_path(company), class: 'btn btn-warning btn-sm' %>
            <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
