<%= link_to companies_path, class: 'btn btn-link ' do %>
  <i class="bi bi-arrow-left me-2"></i> Back to companies
<% end %>
<%= form_with model: @company, class: "d-flex flex-column align-items-center" do |form| %>
  <div class="form-container w-75">

    <% if @company.errors.any? %>
      <div class="alert alert-danger text-center">
        <h4>There were errors with your submission:</h4>
        <ul>
          <% @company.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Company Name -->
    <div class="form-group mb-3 w-100">
      <%= form.label :company_name, class: 'form-label' %>
      <%= form.text_field :company_name, class: 'form-control' %>
    </div>

    <!-- Description -->
    <div class="form-group mb-3 w-100">
      <%= form.label :description, class: 'form-label' %>
      <%= form.text_field :description, class: 'form-control' %>
    </div>

    <!-- Location -->
    <div class="form-group mb-3 w-100">
      <%= form.label :location, class: 'form-label' %>
      <%= form.text_field :location, class: 'form-control' %>
    </div>

    <!-- Review -->
    <div class="form-group mb-4 w-100">
      <%= form.label :review, class: 'form-label' %>
      <%= form.text_field :review, class: 'form-control' %>
    </div>

    <!-- Submit Button -->
    <div class="form-group mb-3">
      <%= form.submit (@company.new_record? ? "Create Company Profile" : "Update Company Profile"), class: 'btn btn-primary' %>
    </div>

  </div>
<% end %>


 
