<h1 class="page-title">Applied Jobs</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Job Title</th>
      <th>Applicant</th>
      <th>Company</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @applied_job.each do |applied_job| %>
      <tr>
        <td><%= applied_job.job_post.title %></td>
        <td>
    <% if applied_job.user.profile_information.present? %>
      <%= applied_job.user.profile_information.firstname %>
    <% else %>
      No Profile
    <% end %>
  </td>
        <td><%= applied_job.job_post.company.company_name %></td>
        <td><%= applied_job.status.capitalize %></td>
        <td>
          <%= link_to 'Show', applied_job_path(applied_job), class: 'btn btn-show' %>
          <% if current_user.admin? || current_user.recruiter? %>
          <%= link_to 'Edit', edit_applied_job_path(applied_job), class: 'btn btn-edit' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>


