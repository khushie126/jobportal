
<h1 class="page-title text-center mb-5">Applied Jobs</h1>

<div class="text-center mb-4">
  <%= link_to 'Back', root_path, class: 'btn btn-secondary btn-lg' %>
</div>
<% if @applied_job.present? %>
<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle shadow-sm">
    <thead class="table-dark">
      <tr class="text-center">
        <th scope="col">Job Title</th>
        <th scope="col">Applicant</th>
        <th scope="col">Company</th>
        <th scope="col">Status</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
     
      <% @applied_job.each do |applied_job| %>
    
        <tr>
          <td><strong><%= applied_job.job_post.title %></strong></td>
          
          <td>
            <% if applied_job.user.profile_information.present? %>
              <%= applied_job.user.profile_information.firstname %>
            <% else %>
              <span class="text-muted">No Profile</span>
            <% end %>
          </td>

          <td><%= applied_job.job_post.company.company_name %></td>
          <td>
            <span class="badge bg-<%= applied_job.status == 'pending' ? 'warning' : 'success' %> text-uppercase">
              <%= applied_job.status.capitalize %>
            </span>
          </td>

          <td class="text-center">
            <%= link_to 'Show', applied_job_path(applied_job), class: 'btn btn-info btn-sm me-1' %>
            
            <% if current_user.admin? || current_user.recruiter? %>
              <%= link_to 'Edit', edit_applied_job_path(applied_job), class: 'btn btn-warning btn-sm' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% else %>
  <div class="alert alert-info text-center mt-5">
    No jobs have been applied to yet.
  </div>
<% end %>