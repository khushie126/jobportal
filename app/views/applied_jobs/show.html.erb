<!-- app/views/applied_jobs/show.html.erb -->
<h1 class="my-4">Applied Job Details</h1>

<div class="card">
  <div class="card-body">
    
    <% if @applied_job.user.profile_information.present? %>
    <p><strong>Applicant:</strong> <%= @applied_job.user.profile_information.firstname %></p>
    <%end%>
    <p><strong>Job Title:</strong> <%= @applied_job.job_post.title %></p>
    <p><strong>Company:</strong> <%= @applied_job.company.company_name %></p>
    <p><strong>Status:</strong> <%= @applied_job.status.capitalize %></p>
    
    <div class="d-flex justify-content-between align-items-center">
      <div>
           <% if current_user.recruiter? || current_user.admin? %>
        <%= link_to 'Edit Status', edit_applied_job_path(@applied_job), class: 'btn btn-warning' %>
      <% end %>
      <%= link_to 'Back to Job Post', job_post_path(@applied_job.job_post), class: 'btn btn-secondary' %>
   
    </div>
    </div>
  </div>
</div>

